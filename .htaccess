# Rely Service Apache config for shared cPanel hosting.
#
# THIS FILE MUST BE UPLOADED TO public_html/ FOR THE SITE TO WORK.
# It begins with a dot, so cPanel's File Manager hides it by default:
#   Settings (top right) -> tick "Show Hidden Files (dotfiles)" -> Save
# Without it, /about returns 404 and only /about.php works.
#
# TROUBLESHOOTING: if the whole site returns 500 after uploading this, the host
# has restricted AllowOverride. Comment out the "Options -Indexes" line at the
# bottom first, reload, and if it still fails comment out the <IfModule
# mod_headers.c> block. Everything above the security headers is standard on
# cPanel and rarely a problem.

DirectoryIndex index.php

# --- Clean URLs (the part that makes /about work) ----------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS. The certificate is active, so this is on.
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # Serve one hostname only. The site is published on the bare domain, so www
  # redirects to it. Both currently answer, which splits search rankings across
  # two addresses and shows visitors two different URLs for the same page.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # /about.php  ->  /about   (301, so the clean URL is the canonical one).
  #
  # The first condition is essential. This rule matches on THE_REQUEST, the raw
  # request line, which still holds the original URL while Apache is rendering
  # ErrorDocument 404. Without the guard, any 404 on a .php address (including
  # /includes/config.php) is answered with a 301 to the stripped path instead of
  # a 404. REDIRECT_STATUS is empty only on the initial request.
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteCond %{REQUEST_URI} !^/(includes|storage)/ [NC]
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # /index -> /  so the homepage has exactly one URL.
  RewriteRule ^index/?$ / [R=301,L]

  # Strip a trailing slash: /about/ and /about would otherwise both resolve.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # /about  ->  about.php  (internally; the browser keeps the clean URL)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^(.+?)/?$ $1.php [L]
</IfModule>

ErrorDocument 404 /404.php

# --- Block access to server-side directories and files ----------------------
RedirectMatch 404 ^/storage(/.*)?$
RedirectMatch 404 ^/includes(/.*)?$

# Original client logos: never used by the site, 4.4MB, and currently public.
RedirectMatch 404 ^/assets/img/clients-src(/.*)?$

<FilesMatch "\.(csv|log|md|json|lock|txt)$">
  Require all denied
</FilesMatch>
# robots.txt and the sitemap must stay reachable despite the .txt rule above.
<FilesMatch "^(robots\.txt|sitemap\.xml)$">
  Require all granted
</FilesMatch>

# The dev-only router must never run in production. Better still, do not upload
# router.php, README.md or CONTENT.md at all.
<Files "router.php">
  Require all denied
</Files>

# --- Security headers -------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  # Also sent from PHP for pages; this covers static assets, and hosts where
  # PHP headers are stripped. Keep the two in step.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-DamCoPgB/VkDCPsu0R6X4sJsz1c66vGlUGBXLu04Yxg='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
  # Stop advertising the PHP version.
  Header always unset X-Powered-By
  # Turn on once you are certain the site will not revert to plain HTTP. It
  # instructs browsers to refuse HTTP for a year, and cannot be undone quickly.
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# --- Compression ------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
                                application/javascript application/json \
                                image/svg+xml
</IfModule>

# --- Browser caching --------------------------------------------------------
# CSS and JS are cache-busted by the ?v= query string in header.php. Bump that
# number whenever you edit style.css or main.js, or returning visitors keep the
# old file for up to a year.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType font/woff2              "access plus 1 year"
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

# Directory listings off. This is the single most likely line to trigger a 500
# on a host with restricted AllowOverride, so it is last: comment it out first
# if the site errors after upload.
Options -Indexes
