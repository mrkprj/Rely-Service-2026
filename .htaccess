# Rely Service Apache config for shared cPanel hosting.
# Safe to drop in as-is. If a rule causes a 500 error on your host, comment it
# out and reload; shared hosts occasionally disable individual modules.

Options -Indexes
DirectoryIndex index.php

# --- Clean URLs -------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS (turn this on only AFTER your SSL certificate is active).
  # RewriteCond %{HTTPS} !=on
  # RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # Force the www. host so you don't split SEO across two hostnames.
  # Flip the condition if you prefer the bare domain.
  # RewriteCond %{HTTP_HOST} !^www\. [NC]
  # RewriteRule ^(.*)$ https://www.%{HTTP_HOST}/$1 [R=301,L]

  # /about.php  ->  /about   (301, so the clean URL is the canonical one)
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # /index -> /  so the homepage has exactly one URL. Without this, /index
  # serves the same page as / and search engines see duplicate content.
  RewriteRule ^index/?$ / [R=301,L]

  # Strip a trailing slash from page URLs, for the same reason: /about/ and
  # /about would otherwise both resolve and both be indexable.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # /about  ->  about.php  (internally; the browser keeps the clean URL)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^(.+?)/?$ $1.php [L]
</IfModule>

ErrorDocument 404 /404.php

# --- Block access to server-side directories --------------------------------
RedirectMatch 404 ^/storage(/.*)?$
RedirectMatch 404 ^/includes(/.*)?$

<FilesMatch "\.(csv|log|md|json|lock|txt)$">
  Require all denied
</FilesMatch>
# robots.txt and the sitemap must stay reachable despite the .txt rule above.
<FilesMatch "^(robots\.txt|sitemap\.xml)$">
  Require all granted
</FilesMatch>

# Original client logo files: kept in the repo for re-processing, never needed
# by the site, and 4.4MB of avoidable exposure if uploaded.
RedirectMatch 404 ^/assets/img/clients-src(/.*)?$

# The dev-only router must never run in production.
<Files "router.php">
  Require all denied
</Files>

# --- Security headers -------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  # Also sent from PHP for pages; this covers static assets, and hosts where
  # PHP headers are stripped. Keep the two in step.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-DamCoPgB/VkDCPsu0R6X4sJsz1c66vGlUGBXLu04Yxg='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
  # Stop advertising the PHP version.
  Header always unset X-Powered-By
  # Enable once the site is fully on HTTPS and you're sure you won't revert:
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# --- Compression ------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
                                application/javascript application/json \
                                image/svg+xml
</IfModule>

# --- Browser caching --------------------------------------------------------
# CSS and JS are cache-busted by the ?v= query string in header.php. Bump that
# number whenever you edit style.css or main.js, or returning visitors keep the
# old file for up to a year.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType font/woff2              "access plus 1 year"
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>
